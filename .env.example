# Copy to .env and put YOUR OWN values here. All app data lands in this database
# (open the same URI in MongoDB Compass to see it).
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/ai_study_companion
# ...or your own Atlas cluster instead:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/ai_study_companion
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-your-own-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
# AI provider: mock | gemini (default mock — no key needed)
AI_PROVIDER=mock
# Fallback when primary fails: mock | none (default: mock if primary=gemini, else none)
AI_FALLBACK_PROVIDER=none
# Gemini (backend only — NEVER expose to the frontend, never commit .env):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# gemini-embedding-2 defaults to 3072; we truncate to 768 for the Atlas index.
GEMINI_EMBEDDING_DIMENSION=768
# Per-call timeout ms (min 1000) + one retry for transient faults only
AI_TIMEOUT_MS=25000
# Chunk/query embeddings: auto (gemini iff AI_PROVIDER=gemini) | gemini | mock | off
AI_EMBEDDINGS=auto
# Retrieval mode: vector (MongoDB Atlas Vector Search, default) | tfidf (no Atlas required)
RETRIEVAL_MODE=vector
# Atlas Vector Search index name (only used when RETRIEVAL_MODE=vector)
VECTOR_SEARCH_INDEX=chunk_vector_index
# Vector search candidates pool (higher = more accurate but slower)
VECTOR_NUM_CANDIDATES=100
# Evidence thresholds for vector retrieval (tune with real data)
VECTOR_EVIDENCE_STRONG_SCORE=0.75
VECTOR_EVIDENCE_MODERATE_SCORE=0.5
# Backfill settings
BACKFILL_BATCH_SIZE=50
BACKFILL_MAX_RETRIES=3
BACKFILL_TEST_LIMIT=0
BACKFILL_DRY_RUN=false
# Dev/test failure simulation (default OFF — demo the fallback without breaking Gemini):
# GEMINI_SIMULATE_FAILURE=true
# GEMINI_SIMULATE_ERROR=quota_exceeded
# GEMINI_SIMULATE_DELAY_MS=0
# GEMINI_SIMULATE_BAD_JSON=false
# Deployment: set VITE_API (or API in client/src/lib/api.js) to the backend URL
